{
  "name": "AI Startup Incubator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  // Builds venv/ from requirements.txt and unpacks the big data files.
  // Runs once, when the codespace is first created.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Don't open the editor until venv/ is built, or students run python too early.
  "waitFor": "postCreateCommand",

  // venv/bin comes first on PATH, so "python" and "pip" are the course venv
  // in every terminal, whether or not the student ran "source venv/bin/activate".
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/venv/bin:${containerEnv:PATH}",
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/venv"
  },

  // Codespaces asks each student for their key when they create a codespace.
  // It becomes an environment variable, so load_dotenv() / ChatOpenAI pick it up
  // without a .env file.
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "Your OpenAI API key (starts with sk-). Needed for the LangChain / OpenAI sessions.",
      "documentationUrl": "https://platform.openai.com/api-keys"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
